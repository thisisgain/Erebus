{#
  views/base.twig — Base layout. Extended by page-specific templates.
  Not used for block/FSE templates (those use /templates/*.html).
#}
<!DOCTYPE html>
<html class="no-js no-touchevents" lang="{{ language }}">
<head>
  {% block head %}
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <link rel="icon" type="image/png" href="{{ theme.link }}/favicon-96x96.png" sizes="96x96" />
  <link rel="icon" type="image/svg+xml" href="{{ theme.link }}/favicon.svg" />
  <link rel="shortcut icon" href="{{ theme.link }}/favicon.ico" />
  <link rel="apple-touch-icon" sizes="180x180" href="{{ theme.link }}/apple-touch-icon.png" />
  <meta name="apple-mobile-web-app-title" content="Vaccination UK" />
  <link rel="manifest" href="{{ theme.link }}/site.webmanifest" />

  {% endblock %}
  {% do fn('wp_head') %}
</head>
<body class="{{ body_class }}">
  {% do fn('wp_body_open') %}
  {% block header %}
    {% include 'views/partials/header.twig' %}
  {% endblock %}
  {% block content %}{% endblock %}
  {% block footer %}
    {% include 'views/partials/footer.twig' %}
  {% endblock %}
  {% do fn('wp_footer') %}
</body>
</html>
