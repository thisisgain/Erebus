<footer class="site-footer">
    
    <div class="container">
        
        <div class="grid">

            <div class="col-span-12 sm:col-span-6">

                {% if site.footer.footerlogo %}
                    {{ site.footer.footerlogo }}
                {% endif %}

                {% if site.footer.address %}
                    <address class="site-footer__address">{{ site.footer.address }}</address>
                {% endif %}

                {% if site.footer.company_number %}
                    <p class="site-footer__text">{{ site.footer.company_number }}</p>
                {% endif %}

            </div>

            {% if site.social_media %}
            <div class="col-span-12 sm:col-span-6">
                <ul class="site-footer__social">
                {% for social in site.social_media %}
                    {% if social.link %}
                    <li>
                        <a href="{{ social.link }}">
                            {% if social.icon and social.icon.url %}
                                <img src="{{ social.icon.url }}" alt="{{ social.name }}">
                            {% endif %}
                            {% if not social.text_hidden %}
                                {{ social.name }}
                            {% endif %}
                        </a>
                    </li>
                    {% endif %}
                {% endfor %}
                </ul>
            </div>
            {% endif %}
        
        </div>

        <hr class="site-footer__divider">

        <div class="grid">
            <div class="col-span-12 sm:col-span-9">

                {% if site.footer.legal %}
                    <p>{{ site.footer.legal }}</p>
                {% endif %}

                {% if menus.footer %}
                    <nav class="site-footer__nav">
                        <ul class="site-footer__nav-list">
                            {% for item in menus.footer.items %}
                                <li class="site-footer__nav-item">
                                    <a class="site-footer__nav-link" href="{{ item.url }}">{{ item.title }}</a>
                                </li>
                            {% endfor %}
                        </ul>
                    </nav>
                {% endif %}

            </div>
        </div>
        
    </div>
</footer>
